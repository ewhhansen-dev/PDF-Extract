{
  "manifest_version": 3,
  "name": "Pure Text & PDF Extractor",
  "version": "3.1",
  "description": "Extract pure typewriter-grade text, PDF, or Markdown from any webpage, chat thread, canvas, popup, or code block. Right-click or use the toolbar icon.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extract Content",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "copy-page-text": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Copy purified page text to clipboard"
    },
    "page-to-txt": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Export page as .txt file"
    },
    "page-to-pdf": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Export page as Typewriter PDF"
    }
  }
}
